<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM PADRE (la raíz del repo).
  Aquí va lo que comparten TODOS los módulos: versión de Java, versión de JUnit y las
  versiones de los plugins. Cada módulo (parqueo-api, avisos) "hereda" de este archivo.
  packaging = pom -> este POM no genera un .jar, solo agrupa módulos.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Coordenadas del artefacto: groupId + artifactId + version = su "dirección" única -->
  <groupId>mx.itson.devops</groupId>
  <artifactId>parqueo-track</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ParqueoTrack</name>

  <modules>
    <module>parqueo-api</module>
    <module>avisos</module>
  </modules>

  <properties>
    <!-- Java del bytecode, sin depender del IDE -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>

    <!-- Datos para SonarQube Cloud (Fase 7). Cambia TU_USUARIO por tu usuario de GitHub. -->
    <sonar.organization>TU_USUARIO</sonar.organization>
    <sonar.projectKey>TU_USUARIO_parqueo-track</sonar.projectKey>
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
  </properties>

  <build>
    <!--
      pluginManagement = "aquí fijo las versiones". No ejecuta nada por sí solo:
      cada módulo decide si usa el plugin o no, pero siempre con la versión de aquí.
    -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- Si no corre ninguna prueba, el build FALLA (por omisión sería "éxito") -->
            <failIfNoTests>true</failIfNoTests>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.13</version>
          <executions>
            <execution>
              <!-- prepare-agent: engancha JaCoCo a la JVM de las pruebas para medir cobertura -->
              <id>prepare-agent</id>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <!-- report: convierte lo medido en un reporte (HTML y XML) al terminar test -->
              <id>report</id>
              <phase>test</phase>
              <goals><goal>report</goal></goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!--
    FASE 8: aquí agregarás <distributionManagement> con las URLs de tu Nexus.
    Mira docs/plantillas/pom-distribucion.xml.ejemplo
  -->
</project>

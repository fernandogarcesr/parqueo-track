<?xml version="1.0" encoding="UTF-8"?>
<!--
  MÓDULO avisos: genera el texto del recibo/aviso para el usuario.
  Es chico a propósito: sirve para practicar builds multi-módulo (-pl, -am) igual que
  notifications-lambda en OrderFlow.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>mx.itson.devops</groupId>
    <artifactId>parqueo-track</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>avisos</artifactId>
  <packaging>jar</packaging>
  <name>ParqueoTrack Avisos</name>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
